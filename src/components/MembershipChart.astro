---
import { membershipByType } from "../data/site";

const total = membershipByType.reduce((s, t) => s + t.count, 0);
const max = Math.max(...membershipByType.map((t) => t.count));

/* Every bar is direct-labeled with its category and value, so identity never
   rests on color and no table view is needed to read the chart. */
const pctOfTotal = (n: number) => Math.round((n / total) * 100);
---

<figure class="viz-root">
  <div class="space-y-5">
    {
      membershipByType.map((t) => (
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <p class="text-sm font-medium text-slate-700">{t.label}</p>
            <p class="text-sm text-slate-500">
              <span class="font-semibold tabular-nums text-navy-900">{t.count}</span>
              <span class="ml-1.5 tabular-nums text-slate-400">{pctOfTotal(t.count)}%</span>
            </p>
          </div>
          <div class="mt-2 h-3 w-full overflow-hidden rounded-sm bg-slate-100">
            <div
              class="h-full rounded-sm"
              style={`width:${(t.count / max) * 100}%;background:${t.color}`}
              role="img"
              aria-label={`${t.label}: ${t.count} members, ${pctOfTotal(t.count)} percent of the chapter`}
            />
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-6 flex items-baseline justify-between border-t border-slate-200 pt-4">
    <p class="text-sm font-semibold text-navy-900">Total members</p>
    <p class="font-display text-xl font-bold tabular-nums text-navy-900">{total}</p>
  </div>

  <figcaption class="mt-4 text-xs leading-relaxed text-slate-500">
    Chapter membership by member type, May 2026. Bars are scaled to the largest category.
  </figcaption>
</figure>
