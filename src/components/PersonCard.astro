---
interface Props {
  name: string;
  role: string;
  institution: string;
  photo?: string;
  linkedin?: string;
}
const { name, role, institution, photo, linkedin } = Astro.props;
const initials = name
  .replace(/\(.*?\)/g, "")
  .replace(/,.*$/, "")
  .trim()
  .split(/\s+/)
  .map((p) => p[0])
  .slice(0, 2)
  .join("");
---

<div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5">
  {
    photo ? (
      <img
        src={photo}
        alt=""
        width="220"
        height="220"
        loading="lazy"
        decoding="async"
        class="h-16 w-16 shrink-0 rounded-full object-cover"
      />
    ) : (
      <span
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-navy-100 font-display text-base font-bold text-navy-700"
        aria-hidden="true"
      >
        {initials}
      </span>
    )
  }
  <div class="min-w-0">
    <p class="font-semibold text-navy-900">{name}</p>
    <p class="text-sm font-medium text-clay-600">{role}</p>
    <p class="mt-0.5 text-sm leading-snug text-slate-500">{institution}</p>
    {linkedin && <a href={linkedin} class="mt-1 inline-block text-sm font-medium text-navy-600 hover:underline">LinkedIn</a>}
  </div>
</div>
