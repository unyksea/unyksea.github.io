---
interface Props {
  title?: string;
  lead?: string;
  tone?: "white" | "tint";
  id?: string;
}
const { title, lead, tone = "white", id } = Astro.props;
---

<section id={id} class:list={["py-14 sm:py-20", tone === "tint" ? "bg-slate-50" : "bg-white"]}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {title && <h2 class="font-display text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">{title}</h2>}
    {lead && <p class="mt-3 max-w-2xl text-slate-600 leading-relaxed">{lead}</p>}
    <div class:list={[title || lead ? "mt-8" : ""]}>
      <slot />
    </div>
  </div>
</section>
