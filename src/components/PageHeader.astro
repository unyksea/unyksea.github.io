---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-slate-200 bg-navy-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-navy-500">{eyebrow}</p>}
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">{lead}</p>}
  </div>
</section>
