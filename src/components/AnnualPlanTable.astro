---
import type { CollectionEntry } from "astro:content";

interface Props {
  events: CollectionEntry<"events">[];
}
const { events } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const kindLabel: Record<string, string> = {
  symposium: "Symposium",
  seminar: "Seminar",
  meeting: "Meeting",
};

---

<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
  <table class="w-full min-w-[44rem] border-collapse text-left text-sm">
    <caption class="sr-only">Planned events for the 2026–2027 program year</caption>
    <thead>
      <tr class="border-b border-slate-200 bg-slate-50">
        <th scope="col" class="px-4 py-3 font-semibold text-navy-800">Date</th>
        <th scope="col" class="px-4 py-3 font-semibold text-navy-800">Event</th>
        <th scope="col" class="px-4 py-3 font-semibold text-navy-800">Type</th>
      </tr>
    </thead>
    <tbody>
      {
        events.map((e) => (
          <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50">
            <td class="whitespace-nowrap px-4 py-3 tabular-nums text-slate-500">{fmt(e.data.date)}</td>
            <th scope="row" class="px-4 py-3 font-medium">
              <a href={`/events/${e.id}`} class="text-navy-800 hover:text-navy-600 hover:underline">
                {e.data.title}
              </a>
            </th>
            <td class="px-4 py-3">
              <span class="rounded-full bg-navy-50 px-2.5 py-1 text-xs font-medium text-navy-700">
                {kindLabel[e.data.kind]}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr class="border-t-2 border-slate-200 bg-slate-50">
        <th scope="row" colspan="3" class="px-4 py-3 text-left font-semibold text-navy-900">
          {events.length} events planned
        </th>
      </tr>
    </tfoot>
  </table>
</div>
