---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import { nationalLinks, institutions } from "../data/site";

const programs = [
  {
    name: "Upstate NY Symposium",
    scope: "Chapter",
    body: "Our annual regional gathering: keynote talks from faculty in the region, lightning research talks from students and postdocs, a career panel, and a networking dinner. The 2025 edition at RIT was the first KSEA event in Upstate New York in over twenty years.",
    href: "/events",
    hrefLabel: "See the symposium archive",
  },
  {
    name: "SEED — early career program",
    scope: "National",
    body: "KSEA's program for early-career researchers, supporting the transition from graduate study and postdoctoral work into independent research careers. Presented at the 2025 symposium by Prof. Juhun Lee of the University of Pittsburgh.",
    href: nationalLinks.home,
    hrefLabel: "Learn more at ksea.org",
  },
  {
    name: "KATALYST",
    scope: "National",
    body: "An undergraduate research conference that gives Korean-American undergraduates a first venue to present their work and meet graduate students and faculty mentors.",
    href: nationalLinks.home,
    hrefLabel: "Learn more at ksea.org",
  },
  {
    name: "National Math and Science Competition",
    scope: "National",
    body: "NMSC is KSEA's long-running competition for K–12 students, held annually at chapter sites across the country. The chapter promotes and supports regional participation.",
    href: nationalLinks.nmsc,
    hrefLabel: "NMSC details",
  },
  {
    name: "Scholarships",
    scope: "National",
    body: "KSEA awards scholarships to Korean-American undergraduate and graduate students each year. Chapter members are encouraged to apply and to serve as reviewers.",
    href: nationalLinks.scholarships,
    hrefLabel: "Scholarship information",
  },
  {
    name: "Technical Groups",
    scope: "National",
    body: "Thirteen discipline-based technical groups connect members working in the same field across all KSEA chapters — a way to find collaborators well beyond Upstate New York.",
    href: nationalLinks.technicalGroups,
    hrefLabel: "Browse technical groups",
  },
];
---

<BaseLayout
  title="Programs"
  description="Chapter and national KSEA programs available to Upstate New York members — symposium, SEED, KATALYST, NMSC, scholarships, and technical groups."
>
  <PageHeader
    eyebrow="Programs"
    title="What we run, and what we connect you to"
    lead="Some programs are ours; most of the rest are national KSEA programs that the chapter makes accessible in this region."
  />

  <Section>
    <div class="grid gap-6 md:grid-cols-2">
      {
        programs.map((p) => (
          <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-3">
              <h2 class="font-display text-xl font-bold text-navy-900">{p.name}</h2>
              <span
                class:list={[
                  "rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide",
                  p.scope === "Chapter" ? "bg-clay-500 text-white" : "bg-navy-100 text-navy-700",
                ]}
              >
                {p.scope}
              </span>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.body}</p>
            <a href={p.href} class="mt-4 text-sm font-semibold text-navy-600 hover:underline">
              {p.hrefLabel} →
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="tint" title="Young Generation (YG)">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="leading-relaxed text-slate-700">
          KSEA's Young Generation track is for undergraduate and graduate students and young professionals. YG groups
          run within local chapters and at individual universities, organizing their own events and feeding into the
          chapter's wider programming.
        </p>
        <p class="mt-4 leading-relaxed text-slate-700">
          With members at Cornell, RIT, Rochester, Binghamton, Buffalo, RPI, and Syracuse, the Upstate NY chapter is
          well positioned to support campus-level YG groups. <strong class="text-navy-900"
            >If you would like to start one at your institution, we will help you set it up.</strong
          >
        </p>
        <a href="/contact" class="mt-5 inline-block text-sm font-semibold text-navy-600 hover:underline"
          >Start a YG group →</a
        >
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Institutions in the chapter</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
          {institutions.map((i) => <li>{i.name}</li>)}
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>
