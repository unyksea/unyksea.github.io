---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-navy-200">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-navy-900">We couldn't find that page</h1>
    <p class="mt-3 text-slate-600">
      It may have moved when the chapter site was rebuilt. Try the events archive or the home page.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-lg bg-navy-700 px-5 py-3 text-sm font-semibold text-white hover:bg-navy-800">Home</a>
      <a href="/events" class="rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Events</a>
    </div>
  </div>
</BaseLayout>
