---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const events = await getCollection("events");
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const { Content } = await render(event);
const [hero, ...rest] = event.data.images;

const dateLabel =
  event.data.status === "tba"
    ? `${event.data.date.getUTCFullYear()} — date to be announced`
    : event.data.date.toLocaleDateString("en-US", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      });
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <article>
    <header class="border-b border-slate-200 bg-navy-50">
      <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
        <a href="/events" class="text-sm font-semibold text-navy-600 hover:underline">← All events</a>
        <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl">
          {event.data.title}
        </h1>
        {event.data.theme && <p class="mt-3 text-lg italic text-clay-600">“{event.data.theme}”</p>}
        <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-wider text-slate-500">Date</dt>
            <dd class="mt-0.5 font-medium text-navy-900">{dateLabel}</dd>
          </div>
          {
            event.data.location && (
              <div>
                <dt class="text-xs uppercase tracking-wider text-slate-500">Location</dt>
                <dd class="mt-0.5 font-medium text-navy-900">
                  {event.data.locationUrl ? (
                    <a
                      href={event.data.locationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-navy-700 underline underline-offset-2 hover:text-navy-500"
                    >
                      {event.data.location}
                    </a>
                  ) : (
                    event.data.location
                  )}
                </dd>
              </div>
            )
          }
        </dl>
        {
          (event.data.registrationUrl || event.data.bookletUrl) && (
            <div class="mt-7 flex flex-wrap gap-3">
              {event.data.registrationUrl && (
                <a
                  href={event.data.registrationUrl}
                  class="rounded-lg bg-navy-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-navy-800"
                >
                  {event.data.registrationLabel ?? "Register"}
                </a>
              )}
              {event.data.bookletUrl && (
                <a
                  href={event.data.bookletUrl}
                  class="rounded-lg border border-navy-300 px-5 py-2.5 text-sm font-semibold text-navy-700 hover:bg-white"
                >
                  Program booklet (PDF)
                </a>
              )}
            </div>
          )
        }
      </div>
    </header>

    {
      hero && (
        <figure class="mx-auto max-w-4xl px-4 pt-10 sm:px-6">
          <img
            src={hero.src}
            alt={hero.alt}
            loading="eager"
            decoding="async"
            class="w-full rounded-xl border border-slate-200 object-cover shadow-sm"
          />
          {hero.caption && <figcaption class="mt-2 text-sm text-slate-500">{hero.caption}</figcaption>}
        </figure>
      )
    }

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <div class="prose-chapter">
        <Content />
      </div>
    </div>

    {
      rest.length > 0 && (
        <div class="mx-auto max-w-4xl px-4 pb-14 sm:px-6">
          <h2 class="font-display text-xl font-bold text-navy-900">Photos</h2>
          <div class="mt-5 grid gap-6 sm:grid-cols-2">
            {rest.map((img) => (
              <figure>
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full rounded-lg border border-slate-200 object-cover"
                />
                {img.caption && <figcaption class="mt-2 text-xs text-slate-500">{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
